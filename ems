function renderLog() {
  const f = visibleLog.filter(r => {
    if (activeLogFilter === 'all') return true;
    if (activeLogFilter === 'alarms') return r.hasAlarm;
    if (activeLogFilter === 'balance') return r.hasBalanceError;
    return r.mode === activeLogFilter;
  });
  const tb = el('minuteLogBody');
  if (tb) tb.innerHTML = f.map((r,i)=>r.html.replace('latest-row', i===f.length-1?'latest-row':'')).join('');
  const ld = document.querySelector('.minute-log');
  const as = el('autoScrollLog');
  if (ld && as?.checked) ld.scrollTop = ld.scrollHeight;
}

