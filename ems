// --- WEATHER FORECAST + PV PREDICTION ---
// Benguerir coordinates
const BENGUERIR_LAT = 32.23;
const BENGUERIR_LON = -7.95;
// PV yield model: MJ/m² → MWh production for 67 MWc plant
// Based on typical Benguerir PR ~0.78, GHI→GTI factor ~1.12
const PV_PEAK_MW = 67;
const PV_PR = 0.78;        // Performance Ratio
const GHI_TO_GTI = 1.12;   // tilt correction for ~25° south
const STD_IRRADIANCE = 3.6; // MJ/m² per peak sun hour

// ── STEP 1: extract last 24h simulated data for calibration ───────────────
function getLast24hStats() {
  if (currentHour < 1) return null;
  const start = Math.max(0, currentHour - 23);
  const slice = hourStates.slice(start, currentHour + 1);
  const totalPvMWh = slice.reduce((s, h) => s + h.pvMWh, 0);
  // Hourly shape normalized 0-1 by hour of day
  const hourlyShape = new Array(24).fill(0);
  for (const h of slice) hourlyShape[h.hourOfDay] += h.pvMWh;
  const maxShape = Math.max(...hourlyShape);
  const normShape = hourlyShape.map(v => maxShape > 0 ? v / maxShape : 0);
  // Effective PR vs theoretical clear-sky max for Benguerir
  const theoreticalMaxMWh = 5.5 * PV_PEAK_MW * GHI_TO_GTI * 0.85;
  const effectivePR = totalPvMWh > 0 ? Math.min(1, totalPvMWh / theoreticalMaxMWh) : PV_PR;
  return { totalPvMWh, normShape, effectivePR, hoursUsed: slice.length };
}

// ── STEP 2: predict daily MWh with calibrated PR ──────────────────────────
function predictWithCalibration(rad, cloud, tmax, calibPR) {
  const pr         = calibPR || PV_PR;
  const tempDerate = 1 - Math.max(0, (tmax - 25) * 0.004);
  const cloudDerate= 1 - (cloud / 100) * 0.75;
  const gtiKwh     = (rad * GHI_TO_GTI) / 3.6;
  return Math.max(0, +(gtiKwh * PV_PEAK_MW * pr * tempDerate * cloudDerate).toFixed(1));
}

// ── STEP 3: build hourly profile using last-24h shape or bell curve ───────
function buildHourlyProfile(dailyMWh, normShape, month) {
  const hasShape = normShape && normShape.some(v => v > 0.05);
  if (hasShape) {
    const total = normShape.reduce((s, v) => s + v, 0);
    return normShape.map(v => total > 0 ? +(v / total * dailyMWh).toFixed(3) : 0);
  }
  const sunriseH = [7.5,7.2,6.8,6.2,5.8,5.5,5.6,6.0,6.4,6.8,7.2,7.5][month] ?? 6.5;
  const sunsetH  = [17.5,18.2,18.8,19.5,20.0,20.3,20.2,19.7,19.0,18.2,17.5,17.2][month] ?? 18.5;
  const peakH = (sunriseH + sunsetH) / 2;
  const dayLen = sunsetH - sunriseH;
  const raw = new Array(24).fill(0);
  let total = 0;
  for (let h = 0; h < 24; h++) {
    if (h < sunriseH || h >= sunsetH) continue;
    const x = (h - peakH) / (dayLen / 4);
    raw[h] = Math.exp(-0.5 * x * x);
    total += raw[h];
  }
  return raw.map(v => total > 0 ? +(v / total * dailyMWh).toFixed(3) : 0);
}

// ── STEP 4: fetch Open-Meteo + run prediction ─────────────────────────────
async function fetchWeatherAndPredict() {
  const btn = el('fetchWeatherButton');
  if (btn) { btn.textContent = '⏳ Fetching...'; btn.disabled = true; }
  txt('weatherSummary', 'Connexion Open-Meteo...');

  // Calibrate from last 24h simulated data
  const stats      = getLast24hStats();
  const calibPR    = stats ? stats.effectivePR : PV_PR;
  const normShape  = stats ? stats.normShape   : null;
  const hasRealData= stats && stats.totalPvMWh > 1;

  try {
    const url = `https://api.open-meteo.com/v1/forecast`
      + `?latitude=${BENGUERIR_LAT}&longitude=${BENGUERIR_LON}`
      + `&daily=shortwave_radiation_sum,cloud_cover_mean,temperature_2m_max,sunrise,sunset`
      + `&forecast_days=7&timezone=Africa%2FCasablanca`;

    const res  = await fetch(url);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();
    const d    = data.daily;

    // Add confidence column to header if not there
    const thead = document.querySelector('#forecastTableBody thead tr');
    if (thead && thead.children.length < 6)
      thead.innerHTML += `<th style="padding:2px 4px;color:#22c55e;">Conf.</th>`;

    const rows = [];
    let totalPredMWh = 0;
    const forecastProfiles = [];

    for (let i = 0; i < d.time.length; i++) {
      const date    = d.time[i];
      const rad     = d.shortwave_radiation_sum[i] || 0;
      const cloud   = d.cloud_cover_mean[i] || 0;
      const tmax    = d.temperature_2m_max[i] || 30;
      const sunrise = (d.sunrise[i] || '').slice(11,16) || '--';
      const sunset  = (d.sunset[i]  || '').slice(11,16) || '--';
      const month   = new Date(date).getMonth();
      // Use last-24h shape only for day 1 (most similar to recent conditions)
      const pvMWh  = predictWithCalibration(rad, cloud, tmax, calibPR);
      const hourly = buildHourlyProfile(pvMWh, i === 0 ? normShape : null, month);
      totalPredMWh += pvMWh;
      forecastProfiles.push({ date, pvMWh, hourly, sunrise, sunset, cloud, rad, tmax });

      // Confidence decreases day by day
      const conf       = Math.max(30, Math.round(96 - i * 9));
      const cloudColor = cloud < 30 ? '#f59e0b' : cloud < 60 ? '#ffd166' : '#8ca4bb';
      const pvColor    = pvMWh > 300 ? '#22c55e' : pvMWh > 150 ? '#f59e0b' : '#94a3b8';
      const confColor  = conf > 80 ? '#22c55e' : conf > 60 ? '#f59e0b' : '#8ca4bb';
      rows.push(`<tr style="border-bottom:1px solid #18283a;">
        <td style="padding:3px 4px;text-align:left;white-space:nowrap;">${date}</td>
        <td style="padding:3px 4px;text-align:center;color:${cloudColor};">${Math.round(cloud)}%</td>
        <td style="padding:3px 4px;text-align:center;">${rad.toFixed(1)}</td>
        <td style="padding:3px 4px;text-align:center;">${tmax.toFixed(1)}</td>
        <td style="padding:3px 4px;text-align:center;font-weight:900;color:${pvColor};">${pvMWh}</td>
        <td style="padding:3px 4px;text-align:center;font-size:9px;color:${confColor};">${conf}%</td>
      </tr>`);
    }

    const today = forecastProfiles[0];
    txt('weatherSummary', `☀ ${today.date} | Lever ${today.sunrise} Coucher ${today.sunset} | ☁ ${Math.round(today.cloud)}% | ${today.tmax.toFixed(1)}°C`);
    txt('sunSummary', `7j total estimé: ${Math.round(totalPredMWh)} MWh | PR calibré: ${(calibPR*100).toFixed(1)}%`);
    setHtml('forecastRows', rows.join(''));
    txt('forecastNote', hasRealData
      ? `✓ Calibré sur ${stats.hoursUsed}h simulées — PV 24h réel: ${stats.totalPvMWh.toFixed(1)} MWh — PR effectif: ${(calibPR*100).toFixed(1)}%`
      : `⚠ Simulation non lancée — PR théorique: ${(PV_PR*100).toFixed(0)}% (lancez la simulation d'abord pour calibrer)`);
    el('weatherForecastTable').style.display = 'block';
    badge('weatherStatus', 'MÉTÉO EN LIGNE', 'online');
    window._forecastProfiles = forecastProfiles;
    if (btn) { btn.textContent = '🔄 Refresh forecast'; btn.disabled = false; }

  } catch (err) {
    console.error(err);
    txt('weatherSummary', `⚠ ${err.message}`);
    txt('sunSummary', 'Fonctionne uniquement en ligne (GitHub Pages / Live Server)');
    badge('weatherStatus', 'MÉTÉO OFFLINE', 'fault');
    if (btn) { btn.textContent = '🌤 Retry forecast'; btn.disabled = false; }
  }
}


