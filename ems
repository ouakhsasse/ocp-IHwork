<script>
// ============================================================
// OCP BENGUERIR PV-BESS SCADA — STANDALONE EMS ENGINE v2
// Fonctionne immédiatement (profil demo) + Excel réel 2025
// ============================================================

// --- CONSTANTES ---
const BESS_MAX_MW        = 25;
const BESS_CAPACITY_MWH  = 125;
const SOC_MIN            = 0;
const SOC_MAX            = 100;
const LOAD_MW            = 15;
const WHEELING_RATE      = 0.7131; // DH/kWh

const TARIFF_SCHEDULE = [
  [0,  7,  "Creuses", 0.5264],
  [7,  17, "Pleines", 0.9017],
  [17, 23, "Pointe",  1.2019],
  [23, 24, "Creuses", 0.5264],
];

function getTariff(h) {
  for (const [s, e, name, rate] of TARIFF_SCHEDULE)
    if (h >= s && h < e) return { name, rate };
  return { name: "Creuses", rate: 0.5264 };
}
function getMode(h) {
  if (h >= 7  && h < 17) return "A";
  if (h >= 17 && h < 23) return "B";
  return "C";
}

// --- PROFIL PV DEMO (24h typique Benguerir, MWh/h) ---
const PV_DEMO_24H = [
  0,0,0,0,0,0,0,
  2.1, 8.4, 18.2, 28.5, 36.7,
  41.2, 43.0, 41.8, 37.3, 29.1,
  18.6, 9.2, 3.1, 0.5, 0,0,0
];

function generateDemoYear() {
  const records = [];
  const base = new Date('2025-01-01T00:00:00');
  for (let h = 0; h < 8760; h++) {
    const d = new Date(base.getTime() + h * 3600000);
    const hod = d.getHours();
    const doy = Math.floor(h / 24);
    // Seasonal factor: peak in summer (day 172), low in winter
    const season = 0.6 + 0.4 * Math.sin((doy - 80) / 365 * 2 * Math.PI);
    // Random daily variability ±15%
    const noise = 0.85 + 0.30 * Math.random();
    const pv = +(PV_DEMO_24H[hod] * season * noise).toFixed(3);
    records.push({ timestamp: d, pvMWh: pv, loadMWh: LOAD_MW });
  }
  return records;
}

// Format date as local "YYYY-MM-DD HH:mm" — avoids UTC shift from toISOString()
function fmtLocalTs(d) {
  const Y  = d.getFullYear();
  const M  = String(d.getMonth()+1).padStart(2,'0');
  const D  = String(d.getDate()).padStart(2,'0');
  const hh = String(d.getHours()).padStart(2,'0');
  const mm = String(d.getMinutes()).padStart(2,'0');
  return `${Y}-${M}-${D} ${hh}:${mm}`;
}

// --- SIMULATION EMS ---
function simulateEms(records, nightCharge) {
  const states = [];
  let soc = 50;
  let cumGain = 0, cumCost = 0, cumBase = 0;

  for (let i = 0; i < records.length; i++) {
    const rec   = records[i];
    const hod   = rec.timestamp.getHours();
    const day   = Math.floor(i / 24) + 1;
    const pv    = rec.pvMWh;
    const load  = rec.loadMWh || LOAD_MW;
    const tariff = getTariff(hod);
    const mode   = getMode(hod);

    const maxChg = Math.min(BESS_MAX_MW, ((SOC_MAX - soc) / 100) * BESS_CAPACITY_MWH);
    const maxDis = Math.min(BESS_MAX_MW, ((soc - SOC_MIN) / 100) * BESS_CAPACITY_MWH);

    let pvLoad=0, pvBess=0, pvWheel=0;
    let bessLoad=0, gridLoad=0, gridBess=0;
    let bessChg=0, bessDis=0;
    let cmd = "GRID_TO_LOAD";

    if (mode === "A") {
      pvLoad  = Math.min(pv, load);
      const sur = pv - pvLoad;
      if (sur > 0.001) {
        pvBess  = Math.min(sur, maxChg);
        pvWheel = Math.max(0, sur - pvBess);
      }
      gridLoad = Math.max(0, load - pvLoad);
      bessChg  = pvBess;
      if (pvBess > 0.001)   cmd = "PV_CHARGE_BESS";
      else if (pvWheel > 0) cmd = "PV_TO_WHEELING";
      else if (gridLoad > 0) cmd = "PV_GRID_TO_LOAD";
      else cmd = "PV_TO_LOAD";

    } else if (mode === "B") {
      pvLoad  = Math.min(pv, load);
      const rem = load - pvLoad;
      bessLoad = Math.min(rem, maxDis);
      gridLoad = Math.max(0, rem - bessLoad);
      const sur = pv - pvLoad;
      if (sur > 0.001) pvWheel = sur;
      bessDis = bessLoad;
      cmd = bessLoad > 0.001 ? "BESS_DISCHARGE_PEAK" : "PV_GRID_TO_LOAD";

    } else { // Mode C — nuit
      gridLoad = load;
      if (nightCharge && tariff.name === "Creuses" && maxChg > 0.5) {
        gridBess = Math.min(BESS_MAX_MW * 0.5, maxChg);
        bessChg  = gridBess;
        cmd = "GRID_CHARGE_BESS_NIGHT";
      }
    }

    const socStart = soc;
    soc = Math.max(SOC_MIN, Math.min(SOC_MAX,
      soc + ((bessChg - bessDis) / BESS_CAPACITY_MWH) * 100));
    const socEnd = soc;

    const gridTotal = gridLoad + gridBess;
    const wheelRev  = pvWheel * 1000 * WHEELING_RATE;
    const cost      = gridTotal * 1000 * tariff.rate - wheelRev;
    const base      = load * 1000 * tariff.rate;
    const gain      = base - cost;
    cumGain += gain; cumCost += cost; cumBase += base;

    const bessPow   = bessChg - bessDis;
    const balErr    = Math.abs((pvLoad + bessLoad + gridLoad) - load);

    const ts = fmtLocalTs(rec.timestamp);
    states.push({
      minute: i, hourIndex: i, excelRowIndex: i,
      timestamp: ts,
      timeLabel: `${String(hod).padStart(2,'0')}:00`,
      hourOfDay: hod, dayNumber: day,
      pvMW: pv, pvMWh: pv,
      loadMW: load, loadMWh: load,
      pvToLoadMW: pvLoad, pvToLoadMWh: pvLoad,
      pvToBessMW: pvBess, pvToBessMWh: pvBess,
      pvToWheelingMW: pvWheel,
      wheelingMW: pvWheel, wheelingMWh: pvWheel,
      bessToLoadMW: bessLoad, bessDischargeMWh: bessDis,
      bessChargeMWh: bessChg,
      gridToLoadMW: gridLoad, gridToLoadMWh: gridLoad,
      gridToBessMW: gridBess, gridToBessMWh: gridBess,
      gridImportMW: gridTotal, gridImportMWh: gridTotal,
      bessPowerMW: bessPow,
      socPercent: socEnd, socStartPercent: socStart, socEndPercent: socEnd,
      socMWh: (socEnd / 100) * BESS_CAPACITY_MWH,
      tariff: tariff.name, tariffDhPerKWh: tariff.rate,
      emsMode: mode, supportMode: null, command: cmd,
      costDh: cost, baselineCostDh: base, netCostDhPerHour: cost,
      cumulativeGainDh: cumGain,
      cumulativeEmsCostDh: cumCost,
      cumulativeBaselineCostDh: cumBase,
      rampEvent: false,
      energyBalanceOk: balErr < 0.01,
      energyBalanceError: balErr,
    });
  }
  return states;
}

// --- ÉTAT GLOBAL ---
let hourStates    = [];
let currentHour   = 0;
let timerId       = null;
let excelLoaded   = false;
let nightCharge   = false;
let activeLogFilter = "all";
let chartWindowMode = "day";
let visibleLog    = [];
let lastLogged    = null;
let activeCharts  = [];
let chartWinStart = 0;

// Init demo immediately
hourStates = simulateEms(generateDemoYear(), false);

// --- UI UTILS ---
const el  = id => document.getElementById(id);
const txt = (id, v) => { const e = el(id); if (e) e.textContent = String(v); };
const htm = (id, v) => { const e = el(id); if (e) e.innerHTML = v; };
const badge = (id, t, c) => { const e = el(id); if (!e) return; e.textContent = t; e.className = `badge ${c}`; };
const fmt  = (v, d) => isFinite(v) ? Number(v).toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d}) : 'N/A';
const sgn  = (v, d) => (v > 0 ? '+' : '') + fmt(v, d);
const esc  = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

// --- EXCEL PARSE ---
async function loadExcel(file) {
  if (!file) { txt('excelStatus','Sélectionnez le fichier Excel'); return; }
  try {
    txt('excelStatus', `Lecture de "${file.name}"...`);
    const buf = await file.arrayBuffer();
    const wb  = XLSX.read(new Uint8Array(buf), { type:'array', cellDates:true });
    const ws  = wb.Sheets[wb.SheetNames[0]];
    const rows = XLSX.utils.sheet_to_json(ws, { header:1 });

    // Find header row (contains "date")
    let start = 0;
    for (let i = 0; i < Math.min(5, rows.length); i++) {
      if (rows[i]?.some(c => typeof c === 'string' && c.toLowerCase().includes('date'))) {
        start = i + 1; break;
      }
    }

    const records = [];
    for (let i = start; i < rows.length; i++) {
      const row = rows[i];
      if (!row || row.length < 2) continue;
      let d = row[0] instanceof Date ? new Date(row[0])
            : typeof row[0] === 'number' ? new Date(Math.round((row[0]-25569)*86400000))
            : new Date(row[0]);
      if (isNaN(d)) continue;
      d.setMinutes(0, 0, 0);  // normalize to whole hour — fixes ms bug
      records.push({ timestamp: d, pvMWh: +row[1]||0, loadMWh: +row[2]||LOAD_MW });
    }

    if (records.length < 100) {
      txt('excelStatus', `Erreur: seulement ${records.length} lignes lues`); return;
    }

    txt('excelStatus', `Simulation EMS en cours (${records.length} h)...`);
    nightCharge = el('allowNightGridCharging')?.checked || false;
    hourStates  = simulateEms(records, nightCharge);
    excelLoaded = true;

    txt('excelStatus', `✓ ${records.length} heures chargées — démarrage 01/01/2025`);
    badge('pvgisStatus', 'EXCEL 2025 CHARGÉ', 'online');
    badge('emsStatusBadge', 'EMS READY', 'ready');

    // Reset and show hour 0
    pauseSim(false);
    currentHour = 0; chartWinStart = 0; lastLogged = null; visibleLog = [];
    renderLog(); renderCharts(); renderHour(0); renderKpis();

  } catch(err) {
    console.error(err);
    txt('excelStatus', 'Erreur: ' + (err.message || String(err)));
    badge('emsStatusBadge','WARNING','warning');
  }
}

