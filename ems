  el('fetchWeatherButton')?.addEventListener('click', fetchWeatherAndPredict);

  // Init badges and messages
  badge('emsStatusBadge','EMS READY','ready');
  badge('pvgisStatus', 'DEMO MODE', 'warning');
  badge('weatherStatus','WEATHER PENDING','warning');
  txt('excelStatus', 'Upload your hourly production data file (.xlsx) to run the simulation');
  txt('weatherSummary','Click "Fetch 7-day weather forecast" to load live Benguerir météo');
  txt('sunSummary','Benguerir — 32.23°N 7.95°W | Prediction model ready');

  renderHour(0);
  renderCharts();
  renderKpis();
});
