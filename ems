// --- LOG ---
function appendLog(s, h) {
  if (lastLogged === h) return;
  lastLogged = h;
  const bal = s.energyBalanceOk ? 'OK' : 'ERROR';
  const gainDh = s.baselineCostDh - s.costDh;
  const tc = s.tariff==='Pointe'?'pointe':s.tariff==='Pleines'?'pleines':'creuses';
  const hasAlarm = s.gridImportMW>=20 || s.socPercent<=12 || !s.energyBalanceOk;
  visibleLog.push({
    mode: s.emsMode, hasAlarm, hasBalanceError: !s.energyBalanceOk, isEvent: false,
    html: `<tr class="latest-row">
      <td>${esc(s.timestamp)}</td><td>${h+1}</td>
      <td>${fmt(s.pvMWh,3)}</td><td>${fmt(s.loadMWh,3)}</td>
      <td>${fmt(s.pvToLoadMWh,3)}</td><td>${fmt(s.pvToBessMWh,3)}</td>
