function updateChartsLive() {
  if (!activeCharts.length) { renderCharts(); return; }
  const view = getView();
  if (view.start !== chartWinStart || activeCharts[0]?.data?.labels?.length !== view.labels.length) {
    renderCharts(); return;
  }
  activeCharts.forEach(c => { c.data.labels = view.labels; c.update('none'); });
  updateBadges();
}

function getView() {
  if (chartWindowMode === 'year') {
    const st = hourStates.filter((_,i) => i%24===0 && i<=currentHour);
    return { states:st, labels:st.map((_,i)=>`J${i+1}`), start:0 };
  }
  const ds = Math.floor(currentHour/24)*24;
  let start=ds, end=Math.min(currentHour, ds+23);
  if (chartWindowMode==='24h') { start=Math.max(0,currentHour-23); end=currentHour; }
  if (chartWindowMode==='7d')  { start=Math.max(0,currentHour-167); end=currentHour; }
  const st = hourStates.slice(start, end+1);
  return { states:st, labels:st.map((s,i)=>st.length<=48||i%24===0?s.timeLabel:''), start };
}

function updateBadges() {
  const s = hourStates[currentHour]; if (!s) return;
  txt('supplyMixLatest',    `PV ${fmt(s.pvToLoadMW,1)} | BESS ${fmt(s.bessToLoadMW,1)} | Grid ${fmt(s.gridToLoadMW,1)} MW`);
  txt('bessPowerLatest',    `${s.bessPowerMW>=0?'Charge':'Décharge'} ${sgn(s.bessPowerMW,1)} MW`);
  txt('pvAllocationLatest', `Load ${fmt(s.pvToLoadMW,1)} | BESS ${fmt(s.pvToBessMW,1)} | Wheel ${fmt(s.wheelingMW,1)} MW`);
  txt('gridBreakdownLatest',`Load ${fmt(s.gridToLoadMW,1)} | BESS ${fmt(s.gridToBessMW,1)} | Total ${fmt(s.gridImportMW,1)} MW`);
  txt('socLatest',          `${fmt(s.socPercent,1)}%`);
  txt('economicLatest',     `Gain ${fmt(s.cumulativeGainDh,0)} DH`);
  txt('hourCostLatest',     `Base ${fmt(s.baselineCostDh,1)} | EMS ${fmt(s.costDh,1)} | Gain ${fmt(s.baselineCostDh-s.costDh,1)} DH/h`);
}

// --- SIMULATION CONTROLS ---
function startSim() {
  const speed = el('speedSelect')?.value || '1';
  badge('emsStatusBadge','RUNNING','running');
  if (speed === 'instant-full') {
    pauseSim(false);
    currentHour = hourStates.length-1;
    renderHour(currentHour);
    badge('emsStatusBadge','EMS READY','ready');
    return;
  }
  if (speed === 'instant') {
    pauseSim(false); runDay();
    badge('emsStatusBadge','EMS READY','ready'); return;
  }
  pauseSim(false);
  timerId = setInterval(() => step(Number(speed)), 1000);
}

function pauseSim(upd=true) {
  if (timerId) { clearInterval(timerId); timerId=null; }
  if (upd) badge('emsStatusBadge','PAUSED','paused');
}

function step(n) {
  currentHour = Math.max(0, Math.min(hourStates.length-1, currentHour+n));
  renderHour(currentHour);
  if (currentHour >= hourStates.length-1) {
    pauseSim();
    badge('emsStatusBadge','SIMULATION COMPLÈTE','ready');
  }
}

function runDay() {
  currentHour = Math.min(hourStates.length-1, Math.floor(currentHour/24)*24+23);
  renderHour(currentHour);
}

function exportCsv() {
  if (!hourStates.length) return;
  const hdr = 'timestamp,h,day,pv_mwh,load_mwh,pv_load,pv_bess,bess_load,grid_load,grid_bess,wheeling,bess_mw,soc_start,soc_end,tariff,mode,cmd,cost_dh,base_dh,gain_dh,cumul_gain,balance';
  const rows = hourStates.map(s => [
