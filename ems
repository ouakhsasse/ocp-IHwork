function flow(id, v) {
  const e = el(id); if (!e) return;
  e.classList.toggle('active', v > 0.05);
  e.style.strokeWidth = String(2 + Math.min(7, v/8));
  e.style.animationDuration = `${Math.max(0.35, 1.4 - Math.min(1, v/35))}s`;
}

function updateOverlay(s) {
  const ov = el('periodOverlay'); if (!ov) return;
  ov.className = 'period-overlay';
  if (s.tariff === 'Pointe') ov.classList.add('peak');
  else if (s.emsMode === 'C' || s.pvMW <= 0.05) ov.classList.add('night');
}

function renderAlarms(s) {
  const al = [
    { n:'SoC bas (<5%)', sv:'WARNING',  ok: s.socPercent > 5 },
    { n:'SoC haut (>98%)', sv:'INFO',    ok: s.socPercent < 98 },
    { n:'Pointe tarifaire — décharge BESS', sv:'INFO', ok: s.tariff !== 'Pointe' },
    { n:'Import réseau élevé >20 MW', sv:'CRITICAL', ok: s.gridImportMW < 20 },
    { n:'ERREUR BILAN ÉNERGÉTIQUE', sv:'CRITICAL',   ok: s.energyBalanceOk },
  ].filter(a => !a.ok);
