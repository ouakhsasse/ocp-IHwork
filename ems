<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OCP Benguerir PV-BESS SCADA</title>
    <link rel="icon" href="data:,">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            color-scheme: dark;
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            background: #070b12;
            color: #dce7f3;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            background: #070b12;
            overflow-x: auto;
            overflow-y: auto;
        }
        button, select {
            font: inherit;
        }
        .scada-shell {
            width: 100%;
            min-height: 100vh;
            padding-bottom: 80px;
            background:
                linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px),
                #070b12;
            background-size: 28px 28px;
        }
        .topbar {
            position: sticky;
            top: 0;
            z-index: 50;
            display: grid;
            grid-template-columns: minmax(320px, 1fr) auto;
            grid-template-rows: auto auto;
            align-items: center;
            gap: 6px 12px;
            padding: 7px 12px;
            border-bottom: 1px solid #1f3145;
            background: #0b111c;
        }
        .title {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }
        .subline {
            color: #8fa6bd;
            font-family: "Roboto Mono", Consolas, monospace;
            font-size: 11px;
            line-height: 1.2;
        }
        .status-row, .control-row, .connection-row {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }
        .control-row {
            grid-column: 1 / -1;
        }
        .badge {
            display: inline-flex;
            align-items: center;
            min-height: 24px;
            border: 1px solid #29415b;
            border-radius: 4px;
            padding: 2px 7px;
            background: #101a28;
            color: #cfe0f2;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }
        .badge.ready, .badge.running, .badge.online { border-color: #1f8f65; color: #7df2ba; background: #08241c; }
        .badge.paused { border-color: #4175a8; color: #9fd0ff; background: #0b1d30; }
        .badge.warning { border-color: #b8871e; color: #ffd166; background: #2a2108; }
        .badge.fault, .badge.offline { border-color: #a33a3a; color: #ff8b8b; background: #2a0c10; }
        .scada-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 28px;
            border: 1px solid #38536f;
            border-radius: 4px;
            padding: 4px 7px;
            background: #122033;
            color: #dce7f3;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            text-decoration: none;
            cursor: pointer;
        }
        .scada-button:hover { border-color: #5c7fa5; background: #182b44; }
        .scada-button.primary { border-color: #1f8f65; background: #0d3a2b; color: #8ff4c3; }
        .main-grid {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 212px minmax(0, 1fr) 246px;
            align-items: start;
            gap: 8px;
            padding: 8px 10px 80px;
            overflow: visible;
        }
        .center-stack {
            display: grid;
            grid-template-rows: auto auto auto auto;
            gap: 8px;
        }
        .panel {
            border: 1px solid #22364d;
            border-radius: 4px;
            background: rgba(9, 16, 27, 0.96);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
            overflow: hidden;
        }
        .panel-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 30px;
            padding: 6px 9px;
            border-bottom: 1px solid #22364d;
            background: #0d1725;
            color: #b9cbe0;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .metric-list {
            display: grid;
            gap: 6px;
            padding: 8px;
        }
        .metric {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 6px;
            align-items: center;
            min-height: 38px;
            border: 1px solid #1d2d40;
            border-left: 3px solid #3e5d7d;
            border-radius: 4px;
            padding: 5px 7px;
            background: #0b1422;
        }
        .metric-label {
            color: #8ca4bb;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .metric-value {
            color: #e9f2fb;
            font-family: "Roboto Mono", Consolas, monospace;
            font-size: 15px;
            font-weight: 900;
            text-align: right;
            white-space: nowrap;
        }
        .metric.pv { border-left-color: #f59e0b; }
        .metric.load { border-left-color: #16c6b7; }
        .metric.bess { border-left-color: #818cf8; }
        .metric.grid { border-left-color: #ef4444; }
        .metric.wheel { border-left-color: #22c55e; }
        .mimic {
            position: relative;
            min-height: 430px;
            background:
                radial-gradient(circle at 50% 45%, rgba(29, 78, 216, 0.12), transparent 40%),
                #080f1a;
        }
        .period-overlay {
            position: absolute;
            inset: 0;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s ease;
        }
        .period-overlay.night { background: rgba(2, 6, 23, 0.42); opacity: 1; }
        .period-overlay.peak { background: rgba(127, 29, 29, 0.2); opacity: 1; }
        .node {
            position: absolute;
            width: 138px;
            min-height: 66px;
            border: 1px solid #36516e;
            border-radius: 5px;
            background: #0d1725;
            padding: 8px;
            box-shadow: 0 14px 32px rgba(0,0,0,0.28);
        }
        .node-title {
            font-size: 11px;
            color: #cbd9e8;
            font-weight: 900;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .node-value {
            margin-top: 5px;
            font-family: "Roboto Mono", Consolas, monospace;
            font-size: 15px;
            color: #ffffff;
            font-weight: 900;
        }
        .node small {
            display: block;
            margin-top: 2px;
            color: #8198af;
            font-size: 10px;
            font-weight: 700;
        }
        .pv-node { left: 5%; top: 12%; border-color: #f59e0b; }
        .inv-node { left: 38%; top: 18%; }
        .bess-node { left: 16%; bottom: 16%; border-color: #818cf8; }
        .load-node { right: 7%; top: 18%; border-color: #16c6b7; }
        .grid-node { right: 8%; bottom: 15%; border-color: #ef4444; }
        .wheel-node { left: 43%; bottom: 8%; border-color: #22c55e; }
        .flow-svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }
        .flow-line {
            fill: none;
            stroke-width: 4;
            stroke-linecap: round;
            opacity: 0.18;
            stroke-dasharray: 10 10;
            animation: dash 1.1s linear infinite;
        }
        .flow-line.active { opacity: 0.9; }
        .flow-label {
            position: absolute;
            min-width: 74px;
            border: 1px solid #2c455f;
            border-radius: 4px;
            padding: 2px 5px;
            background: rgba(7, 11, 18, 0.86);
            font-family: "Roboto Mono", Consolas, monospace;
            font-size: 11px;
            font-weight: 900;
            text-align: center;
        }
        @keyframes dash { to { stroke-dashoffset: -20; } }
        .controls {
            padding: 8px;
            display: grid;
            gap: 8px;
            overflow: visible;
        }
        .field {
            display: grid;
            gap: 5px;
        }
        .field label {
            color: #8ca4bb;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        .field select {
            width: 100%;
            height: 30px;
            border: 1px solid #2d4762;
            border-radius: 4px;
            background: #101a28;
            color: #e9f2fb;
            padding: 0 7px;
            font-size: 12px;
            font-weight: 800;
        }
        .command-box {
            border: 1px solid #315072;
            border-radius: 4px;
            padding: 8px;
            background: #0b1422;
            font-family: "Roboto Mono", Consolas, monospace;
            color: #93f0bd;
            font-size: 13px;
            font-weight: 900;
            overflow-wrap: anywhere;
        }
        .excel-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
        }
        .excel-file {
            width: 100%;
            border: 1px solid #2d4762;
            border-radius: 4px;
            background: #101a28;
            color: #dce7f3;
            padding: 5px;
            font-size: 10px;
        }
        .toggle-row {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #c7d6e6;
            font-size: 11px;
            font-weight: 800;
        }
        .minute-grid {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 4px 8px;
            font-size: 10px;
            line-height: 1.25;
        }
        .minute-grid span:nth-child(odd) { color: #8ca4bb; }
        .minute-grid span:nth-child(even) {
            color: #f8fbff;
            font-family: "Roboto Mono", Consolas, monospace;
            text-align: right;
        }
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 6px;
            padding: 8px;
        }
        .minute-supervision-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
            gap: 8px;
            padding: 8px;
        }
        .summary-item {
            border: 1px solid #1d2d40;
            border-radius: 4px;
            background: #0b1422;
            padding: 6px;
            min-width: 0;
        }
        .summary-label {
            color: #8ca4bb;
            font-size: 9px;
            font-weight: 900;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .summary-value {
            color: #f8fbff;
            font-family: "Roboto Mono", Consolas, monospace;
            font-size: 12px;
            font-weight: 900;
            margin-top: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .minute-log {
            min-height: 350px;
            max-height: 500px;
            overflow-y: auto;
            overflow-x: auto;
            border: 1px solid #22364d;
            border-radius: 4px;
        }
        .minute-log table {
            min-width: 1380px;
            width: max-content;
            border-collapse: collapse;
            font-family: "Roboto Mono", Consolas, monospace;
            font-size: 11px;
        }
        .minute-log.compact-log table {
            min-width: 980px;
            font-size: 11px;
        }
        .minute-log.compact-log th:nth-child(3),
        .minute-log.compact-log td:nth-child(3),
        .minute-log.compact-log th:nth-child(9),
        .minute-log.compact-log td:nth-child(9),
        .minute-log.compact-log th:nth-child(13),
        .minute-log.compact-log td:nth-child(13),
        .minute-log.compact-log th:nth-child(14),
        .minute-log.compact-log td:nth-child(14) {
            display: none;
        }
        .minute-log th,
        .minute-log td {
            border-bottom: 1px solid #18283a;
            padding: 5px 7px;
            white-space: nowrap;
            text-align: right;
        }
        .minute-log tbody tr:nth-child(even) td { background: rgba(255,255,255,0.025); }
        .minute-log tbody tr.latest-row td {
            background: rgba(14, 165, 233, 0.16);
            box-shadow: inset 0 1px 0 rgba(125, 211, 252, 0.2), inset 0 -1px 0 rgba(125, 211, 252, 0.2);
        }
        .log-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 3px;
            padding: 1px 5px;
            border: 1px solid #38536f;
            font-size: 10px;
            font-weight: 900;
        }
        .log-badge.creuses { color: #bfe4ff; border-color: #3b82f6; background: #0b1d30; }
        .log-badge.pleines { color: #ffe5a3; border-color: #f59e0b; background: #261b05; }
        .log-badge.pointe { color: #ffd0d0; border-color: #ef4444; background: #2a0c10; }
        .log-badge.mode { color: #d7d2ff; border-color: #818cf8; background: #15143a; }
        .balance-ok { color: #7df2ba; font-weight: 900; }
        .balance-error { color: #ff8b8b; font-weight: 900; }
        .minute-log th {
            position: sticky;
            top: 0;
            background: #0d1725;
            color: #b9cbe0;
            z-index: 1;
        }
        .minute-log th:first-child,
        .minute-log td:first-child,
        .minute-log th:nth-child(11),
        .minute-log td:nth-child(11),
        .minute-log th:nth-child(12),
        .minute-log td:nth-child(12) {
            text-align: left;
        }
        .minute-log .event-row td {
            color: #ffd166;
            text-align: left;
            background: #1f1a0b;
        }
        .alarm-list {
            display: grid;
            gap: 6px;
            max-height: 420px;
            overflow: auto;
        }
        .alarm-list.full-history {
            max-height: 520px;
            padding: 8px;
        }
        .alarm {
            border: 1px solid #263d55;
            border-left: 3px solid #4b6785;
            border-radius: 4px;
            padding: 6px;
            background: #0b1422;
        }
        .alarm.warning { border-left-color: #f59e0b; }
        .alarm.critical { border-left-color: #ef4444; }
        .alarm.acknowledged { opacity: 0.58; }
        .alarm-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            color: #e5edf6;
            font-size: 11px;
            font-weight: 900;
        }
        .alarm-time {
            color: #8298ad;
            font-family: "Roboto Mono", Consolas, monospace;
            font-size: 10px;
            margin-top: 3px;
        }
        .ack {
            border: 1px solid #38536f;
            border-radius: 3px;
            background: #111d2d;
            color: #dce7f3;
            font-size: 10px;
            padding: 2px 5px;
        }
        .bottom-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
            padding: 8px;
        }
        .charts-collapsed { display: none; }
        .chart-panel {
            min-width: 0;
            border: 1px solid #22364d;
            border-radius: 4px;
            background: #09101b;
            padding: 6px;
        }
        .chart-title {
            height: 18px;
            color: #b9cbe0;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        .chart-box {
            position: relative;
            height: 230px;
            min-height: 210px;
        }
        .chart-toolbar {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            padding: 8px;
            border-bottom: 1px solid #22364d;
        }
        .chart-window.active {
            border-color: #22c55e;
            color: #93f0bd;
            background: #0d3a2b;
        }
        .interpretation-panel {
            margin: 8px;
            border: 1px solid #315072;
            border-radius: 4px;
            padding: 8px;
            background: #0b1422;
            color: #dce7f3;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.45;
        }
        .latest-value {
            color: #93f0bd;
            font-family: "Roboto Mono", Consolas, monospace;
            font-size: 10px;
            font-weight: 900;
        }
        .tariff-timeline {
            min-height: 190px;
            display: grid;
            grid-template-rows: 1fr auto;
            gap: 6px;
        }
        .tariff-bar {
            display: grid;
            grid-template-columns: 8fr 10fr 6fr 1fr;
            border: 1px solid #243a52;
            border-radius: 4px;
            overflow: hidden;
            min-height: 74px;
        }
        .tariff-segment {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4px;
            color: #07111d;
            font-size: 10px;
            font-weight: 900;
            text-align: center;
        }
        .tariff-segment.creuses { background: #5b6b7f; color: #eef4fb; }
        .tariff-segment.pleines { background: #f59e0b; }
        .tariff-segment.pointe { background: #ef4444; color: #fff2f2; }
        .timeline-cursor {
            height: 8px;
            width: 100%;
            border: 1px solid #243a52;
            border-radius: 999px;
            background: linear-gradient(90deg, #8fa6bd var(--cursor), #182537 var(--cursor));
        }
        .note {
            position: absolute;
            left: 10px;
            bottom: 8px;
            right: 10px;
            color: #8ca4bb;
            font-size: 10px;
            line-height: 1.35;
        }
        @media (max-width: 1100px) {
            body { overflow: auto; }
            .scada-shell { min-width: 1100px; }
        }
        @media (max-width: 1366px) {
            .main-grid {
                grid-template-columns: 210px minmax(720px, 1fr) 238px;
            }
            .topbar {
                grid-template-columns: 1fr;
            }
            .status-row, .control-row {
                justify-content: flex-start;
            }
            .minute-log {
                min-height: 360px;
            }
            .summary-grid {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }
            .minute-supervision-grid,
            .bottom-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="scada-shell">
        <header class="topbar">
            <div>
                <div class="title">OCP Benguerir PV-BESS SCADA</div>
                <div class="subline"><span id="simDateTime">2025-01-01 00:00</span> Morocco/Benguerir | 67 MWc PV | 25 MW / 125 MWh BESS | OCP load 15 MW</div>
            </div>
            <div class="status-row">
                <span id="emsStatusBadge" class="badge ready">EMS READY</span>
                <span id="pvgisStatus" class="badge warning">PVGIS INIT</span>
                <span id="weatherStatus" class="badge warning">Open-Meteo INIT</span>
                <span class="badge online">Local EMS Engine</span>
                <span class="badge online">Data Logger</span>
            </div>
            <div class="control-row">
                <a href="index.html" class="scada-button">Dashboard</a>
                <a href="OCP EMS Simulator.html" class="scada-button">EMS Study</a>
                <button id="startButton" class="scada-button primary">Start hourly simulation</button>
                <button id="pauseButton" class="scada-button">Pause</button>
                <button id="previousHourButton" class="scada-button">Previous hour</button>
                <button id="nextHourButton" class="scada-button">Next hour</button>
                <button id="resetButton" class="scada-button">Reset empty</button>
                <select id="speedSelect" class="scada-button" aria-label="Simulation speed">
                    <option value="1">1x hour/s</option>
                    <option value="5">5x hours/s</option>
                    <option value="24">24x day/s</option>
                    <option value="instant">Instant day</option>
                    <option value="instant-full">Instant full year</option>
                </select>
                <button id="exportCsvButton" class="scada-button">Export Hourly CSV</button>
                <button id="exportJsonButton" class="scada-button">Export JSON</button>
                <button id="exportHourlyButton" class="scada-button">Export Daily Summary</button>
            </div>
        </header>

        <main class="main-grid">
            <aside class="panel">
                <div class="panel-title"><span>Plant overview</span><span id="plantModeTag">MODE C</span></div>
                <div class="metric-list">
                    <div class="metric pv"><span class="metric-label">PV Power MW</span><span id="pvPower" class="metric-value">0.00</span></div>
                    <div class="metric load"><span class="metric-label">OCP Load MW</span><span id="loadPower" class="metric-value">15.00</span></div>
                    <div class="metric bess"><span class="metric-label">BESS Power MW</span><span id="bessPower" class="metric-value">0.00</span></div>
                    <div class="metric bess"><span class="metric-label">BESS SoC %</span><span id="socPercent" class="metric-value">50.0</span></div>
                    <div class="metric grid"><span class="metric-label">Grid Import MW</span><span id="gridImport" class="metric-value">15.00</span></div>
                    <div class="metric wheel"><span class="metric-label">Wheeling Export MW</span><span id="wheelingExport" class="metric-value">0.00</span></div>
                    <div class="metric"><span class="metric-label">Current tariff</span><span id="currentTariff" class="metric-value">Creuses</span></div>
                    <div class="metric"><span class="metric-label">Current EMS mode</span><span id="currentMode" class="metric-value">C</span></div>
                    <div class="metric"><span class="metric-label">Net cost DH/h</span><span id="netCost" class="metric-value">10,697</span></div>
                    <div class="metric wheel"><span class="metric-label">Cumulative gain DH</span><span id="dailyGain" class="metric-value">0</span></div>
                </div>
            </aside>

            <section class="center-stack">
                <div class="panel mimic" id="mimicPanel">
                    <div id="periodOverlay" class="period-overlay night"></div>
                    <svg class="flow-svg" viewBox="0 0 900 460" preserveAspectRatio="none">
                        <defs>
                            <marker id="arrowPv" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="#f59e0b"/></marker>
                            <marker id="arrowLoad" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="#16c6b7"/></marker>
