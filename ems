      <td>${fmt(s.gridToBessMWh,3)}</td><td>${fmt(s.wheelingMWh,3)}</td>
      <td>${sgn(s.bessPowerMW,2)}</td>
      <td>${fmt(s.socStartPercent,1)}</td><td>${fmt(s.socEndPercent,1)}</td>
